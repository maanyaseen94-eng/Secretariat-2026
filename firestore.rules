rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بس المستخدمين المسجلين (موظفي السكرتارية) يشوفون ويعدلون البيانات
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

/* ملاحظة: هذي قاعدة أساسية للبدء السريع (أي مستخدم مسجل دخوله يقدر
   يعدل كل شي). قبل الإطلاق الفعلي، شدد القواعد حسب الأدوار
   (مثلاً تفريق بين "admin" و"موظف عادي" عبر custom claims أو حقل role
   بمستند المستخدم بمجموعة users/{uid}). */
