rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }

    function hasPerm(p) {
      return isAdmin() || (isSignedIn() && myProfile().permissions.get(p, false) == true);
    }

    // ملف صلاحيات كل مستخدم: أي موظف مسجل يقدر يشوف قائمة الموظفين (بس عشان مطابقة اسم "الى" بكتاب صادر
    // بحساب الموظف المستلم تلقائياً)، لكن التعديل يبقى للمدير حصراً
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // بيانات المكتب: أي مستخدم مسجل يشوفها، بس صاحب صلاحية الاعدادات (أو المدير) يعدلها
    match /office/{doc} {
      allow read: if isSignedIn();
      allow write: if hasPerm('settings');
    }

    // الطلبات الواردة: أي موظف يشوف/يضيف، بس صاحب صلاحية حذف/أرشفة (أو المدير) يعدل أو يحذف
    match /incoming_letters/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if hasPerm('deleteArchive');
    }

    // تسجيل "قراءة الكتاب": أي موظف غير الجهة المرسلة يفتح الكتاب أول مرة، يسجل وقت القراءة
    // (يسمح فقط بتعديل حقول القراءة نفسها، وبس أول مرة، حتى ما ينكتب فوق تاريخ قراءة موجود)
    function isMarkingOutgoingRead() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && affected.hasOnly(['readAt', 'readByName', 'readByUid'])
        && !('readAt' in resource.data)
        && request.auth.uid != resource.data.createdBy;
    }

    // الكتب الرسمية الصادرة: نفس المنطق + تسجيل قراءة + حذف لصاحب صلاحية حذف/أرشفة
    match /outgoing_letters/{id} {
      allow read, create: if isSignedIn();
      allow update: if hasPerm('deleteArchive') || isMarkingOutgoingRead();
      allow delete: if hasPerm('deleteArchive');
    }

    // عداد رقم الكتاب الرسمي: أي موظف مسجل يقدر يزيده تلقائياً عند إرسال كتاب
    match /counters/{id} {
      allow read, write: if isSignedIn();
    }

    // الاجراء الاداري على الكتاب (نص + مرفقات): أي موظف مسجل يشوف/يضيف اجراء،
    // بس صاحب الاجراء نفسه (أو صاحب صلاحية حذف/أرشفة أو المدير) يقدر يعدله أو يحذفه
    function canManageAction() {
      return isSignedIn() && (request.auth.uid == resource.data.createdBy || hasPerm('deleteArchive'));
    }
    match /incoming_letters/{letterId}/actions/{actionId} {
      allow read, create: if isSignedIn();
      allow update, delete: if canManageAction();
    }
    match /outgoing_letters/{letterId}/actions/{actionId} {
      allow read, create: if isSignedIn();
      allow update, delete: if canManageAction();
    }

    // مولد الذكاء الاصطناعي وقوالبه: بس لصاحب صلاحية الذكاء الاصطناعي (أو المدير)
    match /ai_templates/{id} {
      allow read, write: if hasPerm('aiGenerator');
    }
  }
}

/* =========================================================
   خطوة تهيئة لازمة مرة وحدة بعد نشر هذي القواعد:
   افتح Firestore Database → ابدأ مجموعة اسمها "users" → أضف مستند
   الـ Document ID له هو الـ UID تبع حسابك (من Authentication → Users)
   وحطله الحقول:
     role: "admin"
     name: "اسمك"
     email: "بريدك"
   من دونه ما راح تكدر تدخل حتى صفحة "إدارة المستخدمين" نفسها.
   ========================================================= */
